<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="pos_fel.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <!-- Información requerida por la SAT -->
        <xpath expr="//*[@class='cashier']" position="before">
            <div t-if="order.isToInvoice" class="mt-2">
                <div>
                    <span t-esc="order.config.diario_factura_nombre or ''"/>
                </div>
                <div>
                    <span t-esc="order.config.diario_factura_direccion or ''"/>
                </div>
                <div>
                    <span t-esc="order.config.diario_factura_tel or ''"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//*[@class='pos-receipt-customer mt-2']" position="inside">
            <t t-if="order.isToInvoice">
                <div>
                    <span t-esc="order.partner_id.pos_contact_address or ''"/>
                </div>
            </t>
        </xpath>
    </t>

    <t t-name="pos_fel.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">        
        <!-- Información del certificador -->
        <xpath expr="//*[@class='before-footer']" position="after">
            <div t-if="order.isToInvoice" class="mt-2" style="font-size: 75%">
                <div>Documento Tributario Electrónico FEL</div>
                <div>Factura Electrónica</div>
                <div>Certificador</div>
                <div t-if="!order.contingencia_fel">
                    <t t-if="order.firma_fel">
                        <div>Serie: <t t-esc="order.serie_fel || ''"/></div>
                        <div>Número: <t t-esc="order.numero_fel || ''"/></div>
                        <div>Autorización: <t t-esc="order.firma_fel || ''"/></div>
                        <div>Fecha Certificación: <div t-if="order.date_order" id="order-date" t-out="order.formatDateOrTime('date_order')"/></div>
                    </t>
                    <t t-if="order.certificador_fel == 'infile' || !order.certificador_fel">
                        <div>INFILE, S.A.</div>
                        <div>NIT: 12521337</div>
                    </t>
                    <t t-if="order.certificador_fel == 'g4s'">
                        <div>G4S DOCUMENTA, S. A.</div>
                        <div>NIT: 60010207</div>
                    </t>
                    <t t-if="order.certificador_fel == 'gom'">
                        <div>GOM SOLUTIONS, SOCIEDAD ANONIMA</div>
                        <div>NIT: 95189416</div>
                    </t>
                    <t t-if="order.certificador_fel == 'ecofactura'">
                        <div>ECO-FACTURAS</div>
                        <div>NIT: 64281167</div>
                    </t>
                    <t t-if="order.certificador_fel == 'digifact'">
                        <div>DIGIFACT SERVICIOS, SOCIEDAD ANONIMA</div>
                        <div>NIT: 77454820</div>
                    </t>
                    <t t-if="order.certificador_fel == 'ccg'">
                        <div>Cámara de Comercio de Guatemala</div>
                        <div>NIT: 351598</div>
                    </t>
                    <t t-if="order.certificador_fel == 'megaprint'">
                        <div>MEGAPRINT, S.A.</div>
                        <div>NIT: 50510231</div>
                    </t>
                    <t t-if="order.certificador_fel == 'totaldoc'">
                        <div>Grupo CDS, S.A.</div>
                        <div>NIT: 107902281</div>
                    </t>
                </div>
                <div t-if="order.contingencia_fel">
                    <div>Documento en Contingencia</div>
                    <div>Número de Acceso: <span t-esc="order.numero_acceso_fel"/></div>
                </div>
                <t t-if='!order.footer'>
                    <div>Sujeto a pagos trimestrales ISR</div>
                </t>
            </div>
        </xpath>
     </t>
     
</templates>
